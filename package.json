{
  "name": "orientais-extension-vscode",
  "description": "Orientais VSCode Extension",
  "publisher": "orientais",
  "packageManager": "npm@10.9.0",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./dist/extension/extension.js",
  "l10n": "./dist/extension/l10n",
  "resources": "./dist/extension/resources",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "glob": "^10.4.5"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.i-soft.com.cn/toolchain/vscode_ide/vscode_extension.git"
  },
  "contributes": {
    "configuration": [
      {
        "id": "Communication-Monitoring-Config",
        "title": "%configuration.communicationMonitoringConfig%",
        "order": 10,
        "properties": {
          "autosar.CommunicationMonitoringConfig.enabled": {
            "type": "boolean",
            "default": false,
            "description": "%configuration.communicationMonitoringConfig.enabled%"
          },
          "autosar.CommunicationMonitoringConfig.logLevel": {
            "type": "array",
            "default": [
              "info",
              "warn",
              "error"
            ],
            "items": {
              "type": "string",
              "enum": [
                "info",
                "warn",
                "error"
              ],
              "enumDescriptions": [
                "Adds CodeLens at the top of the document",
                "Adds CodeLens at the start of container-like symbols (modules, classes, interfaces, etc)",
                "Adds CodeLens at the start of block-like symbols (functions, methods, etc) lines"
              ]
            },
            "description": "%configuration.communicationMonitoringConfig.logLevel%"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "hello",
        "title": "Hello World"
      },
      {
        "command": "autosar.file.save",
        "title": "保存配置文件",
        "category": "Orientais"
      },
      {
        "command": "autosar.external.start",
        "title": "开始外部服务",
        "icon": "$(server-process)",
        "when": "true",
        "category": "Orientais"
      },
      {
        "command": "autosar.external.execute",
        "title": "执行外部程序",
        "category": "Orientais"
      },
      {
        "command": "autosar.manageExternal",
        "title": "外部程序调试入口",
        "category": "Orientais"
      }
    ],
    "menus": {}
  },
  "scripts": {
    "postinstall": "node scripts/install-hooks.js",
    "hooks:install": "node scripts/install-hooks.js",
    "dev": "turbo dev",
    "dev:extension": "turbo build:dev --filter=orientais-extension",
    "watch": "turbo watch",
    "watch:extension": "turbo watch --filter=orientais-extension",
    "build": "turbo build",
    "build:dev": "turbo build:dev --force",
    "build:extension": "turbo build --filter=orientais-extension",
    "lint": "turbo lint",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write --quiet .",
    "clean": "turbo clean && npm run clean:modules",
    "clean:modules": "rimraf node_modules apps/*/node_modules packages/*/node_modules",
    "clean:dist": "turbo clean",
    "install:all": "npm install",
    "check:deps": "node scripts/install-deps.js check",
    "install:deps": "node scripts/install-deps.js install",
    "reinstall:deps": "node scripts/install-deps.js reinstall",
    "check:deps:win": "scripts\\install-deps.bat check",
    "install:deps:win": "scripts\\install-deps.bat install",
    "reinstall:deps:win": "scripts\\install-deps.bat reinstall",
    "install:native": "npm install --no-optional --no-fund --no-audit",
    "rebuild:native": "npm run clean:modules && npm run install:native",
    "package:quick": "vsce package"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "9.30.1",
    "@playwright/test": "^1.51.1",
    "@tsconfig/node22": "^22.0.1",
    "@types/js-yaml": "4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.0",
    "@types/sortablejs": "1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.41.0",
    "typescript-eslint": "^8.41.0",
    "@vitest/eslint-plugin": "^1.1.39",
    "@vscode/vsce": "^3.6.2",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "jiti": "^2.4.2",
    "jsdom": "^26.0.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "3.5.3",
    "rimraf": "^6.0.1",
    "sass-embedded": "^1.91.0",
    "turbo": "^2.6.1",
    "typescript": "^5.8.3",
    "vite": "^6.2.4",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@types/node": "^24.3.0",
    "globals": "^16.3.0"
  }
}
