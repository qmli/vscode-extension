# EditorConfig 配置文件
# 确保不同编辑器和 IDE 之间的代码风格一致
# https://editorconfig.org

root = true

# 所有文件的默认设置
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript/TypeScript/Vue 文件
[*.{js,jsx,ts,tsx,vue}]
indent_style = space
indent_size = 2

# JSON 文件
[*.{json,jsonc}]
indent_style = space
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown 文件（保留尾随空格）
[*.md]
trim_trailing_whitespace = false

# 配置文件
[{package.json,.prettierrc,.eslintrc}]
indent_style = space
indent_size = 2
