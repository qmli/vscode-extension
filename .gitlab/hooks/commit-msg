#!/bin/sh
# ========================================
# commit-msg hook - 提交消息格式检查
# ========================================
# 
# 功能：在本地验证提交消息是否符合约定式提交规范
# 用途：在推送到 GitLab 前，尽早发现格式问题
# 与 .gitlab-ci/commit-check.yml 保持一致
# ========================================

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo "${BLUE}🔍 检查提交消息格式...${NC}"

# 跳过合并提交
if echo "$COMMIT_MSG" | grep -q "^Merge"; then
    echo "${GREEN}✓ 合并提交，跳过检查${NC}"
    exit 0
fi

# 跳过 revert 提交
if echo "$COMMIT_MSG" | grep -q "^Revert"; then
    echo "${GREEN}✓ Revert 提交，跳过检查${NC}"
    exit 0
fi

# 检查空提交信息
if [ -z "$(echo "$COMMIT_MSG" | tr -d '[:space:]')" ]; then
    echo "${RED}✗ 错误: 提交信息不能为空${NC}"
    exit 1
fi

# 定义提交类型（与 CI 配置保持一致）
COMMIT_TYPES="feat|fix|perf|build|chore|docs|style|refactor|test|revert|ci|localize|deps"

# 获取第一行提交信息
FIRST_LINE=$(echo "$COMMIT_MSG" | head -n 1)

# 验证提交消息格式
if echo "$FIRST_LINE" | grep -qE "^($COMMIT_TYPES)(\([^)]+\))?: .+"; then
    echo "${GREEN}✅ 提交消息格式正确${NC}"
    exit 0
else
    echo ""
    echo "${RED}❌ 提交消息格式错误！${NC}"
    echo ""
    echo "${YELLOW}📖 提交消息格式要求:${NC}"
    echo "   ${BLUE}格式:${NC} <type>(<scope>): <subject>"
    echo "   ${BLUE}类型:${NC} $COMMIT_TYPES"
    echo ""
    echo "${YELLOW}📚 类型说明:${NC}"
    echo "   ${GREEN}feat${NC}     - 新功能"
    echo "   ${GREEN}fix${NC}      - 修复bug"
    echo "   ${GREEN}perf${NC}     - 性能优化"
    echo "   ${GREEN}build${NC}    - 构建系统变动"
    echo "   ${GREEN}chore${NC}    - 构建过程或辅助工具变动"
    echo "   ${GREEN}docs${NC}     - 文档更新"
    echo "   ${GREEN}style${NC}    - 代码格式修改"
    echo "   ${GREEN}refactor${NC} - 代码重构"
    echo "   ${GREEN}test${NC}     - 测试用例"
    echo "   ${GREEN}revert${NC}   - 回滚提交"
    echo "   ${GREEN}ci${NC}       - CI配置变动"
    echo "   ${GREEN}localize${NC} - 国际化/本地化"
    echo "   ${GREEN}deps${NC}     - 依赖项变动"
    echo ""
    echo "${YELLOW}💡 正确示例:${NC}"
    echo "   ${GREEN}feat(user): 添加用户登录功能${NC}"
    echo "   ${GREEN}fix(auth): 修复登录验证bug${NC}"
    echo "   ${GREEN}docs: 更新API文档${NC}"
    echo "   ${GREEN}perf(api): 优化查询性能${NC}"
    echo ""
    echo "${RED}🚫 当前错误格式:${NC} $FIRST_LINE"
    echo ""
    echo "${YELLOW}💡 提示:${NC} 如果确实需要提交，可以使用: ${BLUE}git commit --no-verify${NC}"
    exit 1
fi

