#!/bin/sh
# ========================================
# pre-commit hook - 提交前检查（含 ESLint + type-check + build）
# ========================================
#
# 功能：在提交前执行基本检查、待提交文件的 ESLint、npm run type-check、npm run build
# 用途：代码规范、类型与编译均通过才允许提交
# ========================================

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo "${BLUE}🔍 执行提交前检查...${NC}"

# 获取所有待提交的文件
FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$FILES" ]; then
    echo "${YELLOW}⚠  没有文件待提交${NC}"
    exit 0
fi

echo "📝 检查文件列表:"
echo "$FILES" | sed 's/^/   /'
echo ""

ERRORS=0
WARNINGS=0

# ========================================
# 1. 检查冲突标记
# ========================================
echo "${BLUE}[1/9]${NC} 检查冲突标记..."
# 精确匹配 Git 冲突标记：<<<<<<< HEAD, =======（正好7个）, >>>>>>> branch
CONFLICT_MARKERS=$(git diff --cached --name-only --diff-filter=ACM | xargs grep -nHE '^(<{7} |={7}$|>{7} )' 2>/dev/null || true)
if [ -n "$CONFLICT_MARKERS" ]; then
    echo "${RED}✗ 错误: 发现未解决的合并冲突标记：${NC}"
    echo "$CONFLICT_MARKERS" | sed 's/^/   /'
    ERRORS=$((ERRORS + 1))
else
    echo "${GREEN}✓ 通过${NC}"
fi

# ========================================
# 2. 检查调试代码（已禁用）
# ========================================
echo "${BLUE}[2/9]${NC} 检查调试代码..."
# 已禁用 debugger 检查 - console.log 和 debugger 都允许使用
echo "${GREEN}✓ 跳过（调试代码检查已禁用）${NC}"

# ========================================
# 3. 检查文件大小
# ========================================
echo "${BLUE}[3/9]${NC} 检查文件大小..."
MAX_SIZE=104857600  # 100MB in bytes
LARGE_FILES=0
for FILE in $FILES; do
    if [ -f "$FILE" ]; then
        # 跨平台文件大小检查
        if command -v stat >/dev/null 2>&1; then
            SIZE=$(stat -f%z "$FILE" 2>/dev/null || stat -c%s "$FILE" 2>/dev/null || echo 0)
        else
            SIZE=0
        fi

        if [ "$SIZE" -gt "$MAX_SIZE" ]; then
            echo "${RED}✗ 错误: 文件 $FILE 过大 ($(($SIZE / 1024 / 1024))MB，限制 100MB)${NC}"
            echo "   ${YELLOW}建议: 使用 Git LFS 或不要提交大文件${NC}"
            ERRORS=$((ERRORS + 1))
            LARGE_FILES=1
        fi
    fi
done

if [ $LARGE_FILES -eq 0 ]; then
    echo "${GREEN}✓ 通过${NC}"
fi

# ========================================
# 4. 检查敏感信息
# ========================================
echo "${BLUE}[4/9]${NC} 检查敏感信息..."
SENSITIVE_FOUND=0
# 更精确的模式：只检查真实的敏感信息赋值，排除类型定义
SENSITIVE_PATTERNS="(password|passwd|pwd|secret|api_key|apikey|private_key|access_key|SECRET_KEY|API_KEY)\s*[=]\s*['\"][^'\"]{8,}"
for FILE in $FILES; do
    if [ -f "$FILE" ]; then
        case "$FILE" in
            *.js|*.jsx|*.ts|*.tsx|*.py|*.java|*.php|*.rb|*.go|*.env*)
                # 排除类型定义（: Token）和合法的 API 类型（如 CancellationToken、ApiKey）
                MATCHES=$(grep -nHE "$SENSITIVE_PATTERNS" "$FILE" 2>/dev/null | grep -vE "(import|type|interface|CancellationToken|RefreshToken|AccessToken|ApiKey|APIKey|api_key:|apiKey:)" || true)
                if [ -n "$MATCHES" ]; then
                    echo "$MATCHES" | head -3
                    echo "${YELLOW}⚠  警告: 在 $FILE 中可能包含敏感信息${NC}"
                    echo "   ${YELLOW}请确认是否应该提交该信息${NC}"
                    SENSITIVE_FOUND=1
                    WARNINGS=$((WARNINGS + 1))
                fi
                ;;
        esac
    fi
done

if [ $SENSITIVE_FOUND -eq 0 ]; then
    echo "${GREEN}✓ 通过${NC}"
fi

# ========================================
# 5. 检查禁止提交的文件
# ========================================
echo "${BLUE}[5/9]${NC} 检查禁止提交的文件..."
FORBIDDEN_FOUND=0
# 常见的不应提交的文件
FORBIDDEN_PATTERNS="\.env$ \.env\.local$ \.env\.production$ \.DS_Store$ Thumbs\.db$ \.log$ \.swp$ \.swo$ ~$"
for FILE in $FILES; do
    for PATTERN in $FORBIDDEN_PATTERNS; do
        if echo "$FILE" | grep -qE "$PATTERN"; then
            echo "${RED}✗ 错误: 不允许提交文件: $FILE${NC}"
            ERRORS=$((ERRORS + 1))
            FORBIDDEN_FOUND=1
        fi
    done
done

if [ $FORBIDDEN_FOUND -eq 0 ]; then
    echo "${GREEN}✓ 通过${NC}"
fi

# ========================================
# 6. ESLint 检查（仅检查待提交的文件）
# ========================================
echo "${BLUE}[6/9]${NC} ESLint 代码检查..."

ESLINT_FOUND=0
if [ -f "package.json" ]; then
    if grep -q '"eslint"' package.json 2>/dev/null; then
        ESLINT_FOUND=1
    fi
fi

if [ $ESLINT_FOUND -eq 1 ]; then
    JS_FILES=$(echo "$FILES" | grep -E '\.(js|jsx|ts|tsx|vue)$' || true)

    if [ -n "$JS_FILES" ]; then
        echo "检测到 ESLint 配置，检查以下文件："
        echo "$JS_FILES" | sed 's/^/   /'
        echo ""

        if command -v npx >/dev/null 2>&1; then
            echo "$JS_FILES" | xargs npx eslint --max-warnings 20
            ESLINT_EXIT=$?

            if [ $ESLINT_EXIT -ne 0 ]; then
                echo ""
                echo "${RED}✗ ESLint 检查失败${NC}"
                echo ""
                echo "${YELLOW}💡 修复建议：${NC}"
                echo "   1. 运行 ${BLUE}npm run lint${NC} 查看全部问题"
                echo "   2. 运行 ${BLUE}npm run lint:fix${NC} 尝试自动修复"
                echo "   3. 如确需跳过: ${BLUE}git commit --no-verify${NC}"
                ERRORS=$((ERRORS + 1))
            else
                echo "${GREEN}✓ ESLint 检查通过${NC}"
            fi
        elif command -v pnpm >/dev/null 2>&1; then
            echo "$JS_FILES" | xargs pnpm eslint --max-warnings 20
            ESLINT_EXIT=$?

            if [ $ESLINT_EXIT -ne 0 ]; then
                echo ""
                echo "${RED}✗ ESLint 检查失败${NC}"
                echo "   运行 ${BLUE}pnpm lint:fix${NC} 自动修复"
                ERRORS=$((ERRORS + 1))
            else
                echo "${GREEN}✓ ESLint 检查通过${NC}"
            fi
        else
            echo "${YELLOW}⚠  警告: 未找到 npx 或 pnpm，跳过 ESLint 检查${NC}"
        fi
    else
        echo "${BLUE}ℹ  没有 JS/TS/Vue 文件需要检查${NC}"
    fi
else
    echo "${BLUE}ℹ  未配置 ESLint，跳过检查${NC}"
fi

# ========================================
# 7. TypeScript 类型检查（必须通过才能提交）
# ========================================
echo "${BLUE}[7/9]${NC} 类型检查（npm run type-check）..."

if [ ! -f "package.json" ]; then
    echo "${RED}✗ 错误: 未找到 package.json，无法执行类型检查${NC}"
    ERRORS=$((ERRORS + 1))
elif ! command -v npm >/dev/null 2>&1; then
    echo "${RED}✗ 错误: 未找到 npm，无法执行类型检查${NC}"
    ERRORS=$((ERRORS + 1))
else
    npm run type-check
    TYPECHECK_EXIT=$?
    if [ $TYPECHECK_EXIT -ne 0 ]; then
        echo ""
        echo "${RED}✗ 类型检查失败，提交已阻止${NC}"
        echo ""
        echo "${YELLOW}💡 修复建议：${NC}"
        echo "   1. 在仓库根目录运行 ${BLUE}npm run type-check${NC} 查看完整错误并修复"
        echo "   2. 修复后重新提交"
        echo "   3. 如确需跳过: ${BLUE}git commit --no-verify${NC}"
        ERRORS=$((ERRORS + 1))
    else
        echo "${GREEN}✓ 类型检查通过${NC}"
    fi
fi

# ========================================
# 8. 项目编译（必须通过才能提交）
# ========================================
echo "${BLUE}[8/9]${NC} 项目编译（npm run build）..."

if [ ! -f "package.json" ]; then
    echo "${RED}✗ 错误: 未找到 package.json，无法编译${NC}"
    ERRORS=$((ERRORS + 1))
elif ! command -v npm >/dev/null 2>&1; then
    echo "${RED}✗ 错误: 未找到 npm，无法执行编译${NC}"
    ERRORS=$((ERRORS + 1))
else
    npm run build
    BUILD_EXIT=$?
    if [ $BUILD_EXIT -ne 0 ]; then
        echo ""
        echo "${RED}✗ 编译失败，提交已阻止${NC}"
        echo ""
        echo "${YELLOW}💡 修复建议：${NC}"
        echo "   1. 在仓库根目录运行 ${BLUE}npm run build${NC} 查看完整错误并修复"
        echo "   2. 修复后重新提交"
        echo "   3. 如确需跳过: ${BLUE}git commit --no-verify${NC}"
        ERRORS=$((ERRORS + 1))
    else
        echo "${GREEN}✓ 编译通过${NC}"
    fi
fi

# ========================================
# 9. Prettier 检查（可选）
# ========================================
echo "${BLUE}[9/9]${NC} 代码格式检查..."
# 如果项目使用 prettier，可以运行格式检查
if [ -f "package.json" ] && command -v npx >/dev/null 2>&1; then
    if grep -q '"prettier"' package.json 2>/dev/null; then
        # 取消下面的注释以启用 prettier 检查
        # PRETTIER_FILES=$(echo "$FILES" | grep -E '\.(js|jsx|ts|tsx|vue|css|scss|json|md)$' || true)
        # if [ -n "$PRETTIER_FILES" ]; then
        #     echo "$PRETTIER_FILES" | xargs npx prettier --check
        #     if [ $? -ne 0 ]; then
        #         echo "${RED}✗ Prettier 检查失败${NC}"
        #         echo "   运行 ${BLUE}npm run format${NC} 自动格式化"
        #         ERRORS=$((ERRORS + 1))
        #     fi
        # fi
        echo "${BLUE}ℹ  Prettier 已配置（已禁用自动检查）${NC}"
        echo "   ${YELLOW}提示: 运行 'npm run format' 或 'pnpm format' 格式化代码${NC}"
    fi
fi
echo "${GREEN}✓ 跳过${NC}"

# ========================================
# 检查结果
# ========================================
echo ""
echo "================================"
if [ $ERRORS -gt 0 ]; then
    echo "${RED}✗ 提交前检查失败！${NC}"
    echo "   ${RED}错误: $ERRORS${NC}"
    echo "   ${YELLOW}警告: $WARNINGS${NC}"
    echo ""
    echo "${YELLOW}💡 提示:${NC}"
    echo "   - 请修复以上错误后重新提交"
    echo "   - 如确需提交，可使用: ${BLUE}git commit --no-verify${NC}"
    exit 1
elif [ $WARNINGS -gt 0 ]; then
    echo "${YELLOW}⚠  提交前检查通过（有警告）${NC}"
    echo "   ${GREEN}错误: 0${NC}"
    echo "   ${YELLOW}警告: $WARNINGS${NC}"
    echo ""
    echo "${YELLOW}💡 提示: 建议在推送前处理警告信息${NC}"
else
    echo "${GREEN}✅ 提交前检查全部通过！${NC}"
fi

exit 0

