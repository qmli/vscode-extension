#!/bin/sh
# ========================================
# pre-commit hook - 提交前快速检查（性能优化版）
# ========================================
#
# 默认流程（针对 monorepo 做了瘦身，目标 < 30s）：
#   1. 文件级检查（冲突标记 / 大文件 / 禁止文件 / 敏感信息）—— 一次性遍历
#   2. ESLint —— 仅检查待提交的 JS/TS/Vue 文件
#   3. TypeScript type-check —— 仅检查受影响的 workspace
#   4. (可选) 项目编译 —— 默认关闭，需通过 RUN_BUILD=1 启用
#
# 环境变量（可组合使用）：
#   SKIP_HOOK=1          完全跳过 pre-commit
#   SKIP_ESLINT=1        跳过 ESLint
#   SKIP_TYPECHECK=1     跳过 type-check
#   RUN_BUILD=1          额外执行 npm run build（默认关闭）
#   FULL_TYPECHECK=1     强制全量 type-check（默认只检查变更涉及的 workspace）
#   HOOK_VERBOSE=1       打印更详细的调试信息
#
# 临时跳过整体检查仍可使用：
#   git commit --no-verify
# ========================================

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

# 整体跳过
if [ "${SKIP_HOOK:-0}" = "1" ]; then
    printf "${YELLOW}⚠  SKIP_HOOK=1，跳过 pre-commit 检查${NC}\n"
    exit 0
fi

# 临时日志（用于保存子命令完整输出，便于事后查看）
LOG_DIR="${TMPDIR:-/tmp}"
LOG_FILE="$LOG_DIR/precommit-$$.log"
: > "$LOG_FILE" 2>/dev/null || LOG_FILE=""
cleanup() {
    # 若有错误才保留日志，方便用户查看；否则清理
    if [ "${ERRORS:-0}" -eq 0 ] && [ -n "$LOG_FILE" ]; then
        rm -f "$LOG_FILE" 2>/dev/null || true
    fi
}
trap cleanup EXIT

HOOK_START=$(date +%s)
ERRORS=0
WARNINGS=0
ERROR_DETAILS=""

# ---------- 工具函数 ----------
now() { date +%s; }
elapsed() { echo $(( $(now) - $1 )); }

step_begin() {
    STEP_IDX=$((STEP_IDX + 1))
    STEP_T0=$(now)
    printf "${BLUE}[%d/%d]${NC} %s\n" "$STEP_IDX" "$TOTAL_STEPS" "$1"
}
step_ok()    { printf "      ${GREEN}✓ 通过${NC} ${DIM}(%ss)${NC}\n" "$(elapsed "$STEP_T0")"; }
step_warn()  { printf "      ${YELLOW}⚠ 警告${NC} ${DIM}(%ss)${NC}\n" "$(elapsed "$STEP_T0")"; }
step_fail()  { printf "      ${RED}✗ 失败${NC} ${DIM}(%ss)${NC}\n" "$(elapsed "$STEP_T0")"; }
step_skip()  { printf "      ${DIM}— 跳过：%s${NC}\n" "$1"; }

# 累计错误（带标题 + 详情）
add_error() {
    ERRORS=$((ERRORS + 1))
    ERROR_DETAILS="${ERROR_DETAILS}|||$1"
}

# 文件名是否在禁止名单
is_forbidden_file() {
    case "$1" in
        *.env|*.env.local|*.env.production|*.DS_Store|Thumbs.db|*.log|*.swp|*.swo|*~)
            return 0 ;;
    esac
    return 1
}

# 是否需要做 ESLint 检查的扩展名
is_lintable() {
    case "$1" in
        *.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.vue) return 0 ;;
    esac
    return 1
}

# 是否要做敏感信息扫描的扩展名
is_sensitive_target() {
    case "$1" in
        *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.py|*.java|*.php|*.rb|*.go|*.env|*.env.*) return 0 ;;
    esac
    return 1
}

# 读取 package.json 的 name 字段（不依赖 jq）
read_pkg_name() {
    [ -f "$1" ] || return 1
    awk -F'"' '/^[[:space:]]*"name"[[:space:]]*:/ { print $4; exit }' "$1"
}

# 根据变更文件路径推导 turbo --filter 参数
# 输出形如：--filter=orientais-extension --filter=webview-tree
build_typecheck_filters() {
    files="$1"
    has_root_change=0
    pkg_list=""

    # 先用 printf 转成换行分隔，避免空格分割问题
    OLDIFS=$IFS
    IFS='
'
    for f in $files; do
        case "$f" in
            apps/extension/*)
                pkg_list="$pkg_list orientais-extension" ;;
            apps/webview/*)
                # apps/webview/<name>/...
                name=$(echo "$f" | awk -F'/' '{print $3}')
                [ -n "$name" ] && pkg_list="$pkg_list $name"
                ;;
            packages/*)
                name=$(echo "$f" | awk -F'/' '{print $2}')
                if [ "$name" = "dbdriver" ]; then
                    pkg_list="$pkg_list @packages/dbdriver"
                else
                    [ -n "$name" ] && pkg_list="$pkg_list $name"
                fi
                ;;
            tsconfig*.json|package.json|package-lock.json|turbo.json|eslint.config.*|.npmrc)
                has_root_change=1 ;;
            scripts/*|.gitlab/*|.vscode/*|docs/*|*.md)
                : ;;  # 这些目录不影响构建
            *)
                # 任何无法归属的根目录文件视为根级变更
                has_root_change=1 ;;
        esac
    done
    IFS=$OLDIFS

    if [ "$has_root_change" = "1" ]; then
        echo ""    # 空 → 调用方走全量
        return 0
    fi

    # 去重
    filters=""
    for p in $pkg_list; do
        case "$filters" in
            *"--filter=$p "*) ;;
            *) filters="$filters--filter=$p " ;;
        esac
    done
    echo "$filters"
}

# ---------- 待提交文件 ----------
FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$FILES" ]; then
    printf "${YELLOW}⚠  没有文件待提交${NC}\n"
    exit 0
fi
FILE_COUNT=$(printf '%s\n' "$FILES" | wc -l | awk '{print $1}')

# 计算总步骤数
TOTAL_STEPS=1   # 文件级检查
[ "${SKIP_ESLINT:-0}"    != "1" ] && TOTAL_STEPS=$((TOTAL_STEPS + 1))
[ "${SKIP_TYPECHECK:-0}" != "1" ] && TOTAL_STEPS=$((TOTAL_STEPS + 1))
[ "${RUN_BUILD:-0}"      = "1" ]   && TOTAL_STEPS=$((TOTAL_STEPS + 1))
STEP_IDX=0

printf "${BOLD}${BLUE}🔍 pre-commit 检查${NC}  ${DIM}(待提交 %d 个文件)${NC}\n" "$FILE_COUNT"
printf "${DIM}提示：RUN_BUILD=1 启用编译 | SKIP_TYPECHECK=1 跳过类型检查 | git commit --no-verify 强制提交${NC}\n"
if [ "${HOOK_VERBOSE:-0}" = "1" ]; then
    printf '%s\n' "$FILES" | sed 's/^/   /'
fi
echo ""

# ========================================
# [1] 文件级检查（一次遍历完成多项）
# ========================================
step_begin "文件级检查（冲突标记/大文件/禁止文件/敏感信息）"

MAX_SIZE_BYTES=104857600    # 100MB
CONFLICT_HITS=""
LARGE_HITS=""
FORBIDDEN_HITS=""
SENSITIVE_HITS=""
# 注意：必须排除 type/interface 声明 + 常见 API token 类型
SENSITIVE_REGEX='(password|passwd|pwd|secret|api_key|apikey|private_key|access_key|SECRET_KEY|API_KEY)[[:space:]]*=[[:space:]]*["'"'"'][^"'"'"']{8,}'

OLDIFS=$IFS
IFS='
'
for FILE in $FILES; do
    [ -f "$FILE" ] || continue

    # 1) 禁止文件
    if is_forbidden_file "$FILE"; then
        FORBIDDEN_HITS="${FORBIDDEN_HITS}    ${FILE}
"
        continue
    fi

    # 2) 文件大小
    SIZE=$(wc -c < "$FILE" 2>/dev/null | awk '{print $1+0}')
    if [ "${SIZE:-0}" -gt "$MAX_SIZE_BYTES" ]; then
        LARGE_HITS="${LARGE_HITS}    ${FILE}  ($((SIZE / 1024 / 1024))MB)
"
    fi

    # 3) 冲突标记
    if grep -nE '^(<{7} |={7}$|>{7} )' "$FILE" >/dev/null 2>&1; then
        hits=$(grep -nE '^(<{7} |={7}$|>{7} )' "$FILE" 2>/dev/null | head -3)
        CONFLICT_HITS="${CONFLICT_HITS}    ${FILE}:
$(printf '%s' "$hits" | sed 's/^/        /')
"
    fi

    # 4) 敏感信息（仅对相关扩展名）
    if is_sensitive_target "$FILE"; then
        # 先粗筛，再过滤误报
        matches=$(grep -nE "$SENSITIVE_REGEX" "$FILE" 2>/dev/null \
            | grep -vE '(^[[:space:]]*//|^[[:space:]]*\*|import|type[[:space:]]+|interface[[:space:]]+|CancellationToken|RefreshToken|AccessToken|ApiKey|APIKey|api_key[[:space:]]*:|apiKey[[:space:]]*:)' \
            || true)
        if [ -n "$matches" ]; then
            SENSITIVE_HITS="${SENSITIVE_HITS}    ${FILE}:
$(printf '%s' "$matches" | head -3 | sed 's/^/        /')
"
        fi
    fi
done
IFS=$OLDIFS

if [ -z "$CONFLICT_HITS" ] && [ -z "$LARGE_HITS" ] && [ -z "$FORBIDDEN_HITS" ] && [ -z "$SENSITIVE_HITS" ]; then
    step_ok
else
    # 有任一错误/警告
    [ -n "$SENSITIVE_HITS" ] && [ -z "$CONFLICT_HITS$LARGE_HITS$FORBIDDEN_HITS" ] && step_warn || step_fail

    if [ -n "$CONFLICT_HITS" ]; then
        add_error "$(printf '%b' "${RED}发现未解决的合并冲突标记${NC}\n${CONFLICT_HITS}  ${YELLOW}→ 修复：手动解决冲突后 git add 重新提交${NC}")"
    fi
    if [ -n "$LARGE_HITS" ]; then
        add_error "$(printf '%b' "${RED}文件过大（限制 100MB）${NC}\n${LARGE_HITS}  ${YELLOW}→ 修复：移出大文件，或改用 Git LFS${NC}")"
    fi
    if [ -n "$FORBIDDEN_HITS" ]; then
        add_error "$(printf '%b' "${RED}不允许提交的文件${NC}\n${FORBIDDEN_HITS}  ${YELLOW}→ 修复：git restore --staged <file> 取消暂存${NC}")"
    fi
    if [ -n "$SENSITIVE_HITS" ]; then
        WARNINGS=$((WARNINGS + 1))
        printf "${YELLOW}⚠  疑似敏感信息（仅警告，不阻止提交）：${NC}\n%b" "$SENSITIVE_HITS"
    fi
fi

# ========================================
# [2] ESLint（仅变更文件）
# ========================================
if [ "${SKIP_ESLINT:-0}" = "1" ]; then
    :
else
    step_begin "ESLint（变更文件）"

    JS_FILES=""
    OLDIFS=$IFS
    IFS='
'
    for F in $FILES; do
        if is_lintable "$F" && [ -f "$F" ]; then
            JS_FILES="${JS_FILES}${F}
"
        fi
    done
    IFS=$OLDIFS

    if [ -z "$JS_FILES" ]; then
        step_skip "无 JS/TS/Vue 文件"
    elif ! command -v npx >/dev/null 2>&1; then
        step_skip "未找到 npx"
        WARNINGS=$((WARNINGS + 1))
    else
        # 提升 Node 堆内存上限，避免 typed-linting 在文件较多时 OOM
        # 用户可通过 ESLINT_NODE_MEM 覆盖（单位：MB）
        ESLINT_MEM="${ESLINT_NODE_MEM:-6144}"
        OLD_NODE_OPTIONS="${NODE_OPTIONS:-}"
        export NODE_OPTIONS="$OLD_NODE_OPTIONS --max-old-space-size=$ESLINT_MEM"

        # 输出收集到临时文件，再原样打印，方便后续精准判断 OOM
        ESLINT_LOG="${LOG_FILE}.eslint"
        printf "      ${DIM}运行中...${NC}\n"
        printf '%s' "$JS_FILES" | xargs npx --no-install eslint --max-warnings 20 >"$ESLINT_LOG" 2>&1
        ELINT_EXIT=$?
        cat "$ESLINT_LOG"

        export NODE_OPTIONS="$OLD_NODE_OPTIONS"

        if [ "${ELINT_EXIT:-0}" -ne 0 ]; then
            step_fail
            # 通过输出内容检测 OOM，给出针对性提示
            HINT_OOM=""
            if grep -qiE 'out of memory|heap limit|FATAL ERROR' "$ESLINT_LOG" 2>/dev/null; then
                HINT_OOM="\n  ${YELLOW}→ ESLint 堆内存溢出，提高上限重试：ESLINT_NODE_MEM=8192 git commit ...${NC}"
            fi
            add_error "$(printf '%b' "${RED}ESLint 失败${NC}\n  ${YELLOW}→ 自动修复：npm run lint:fix${NC}\n  ${YELLOW}→ 查看完整问题：npm run lint${NC}${HINT_OOM}")"
        else
            step_ok
            rm -f "$ESLINT_LOG" 2>/dev/null || true
        fi
    fi
fi

# ========================================
# [3] TypeScript type-check（受影响 workspace）
# ========================================
if [ "${SKIP_TYPECHECK:-1}" = "1" ]; then
    :
else
    step_begin "TypeScript type-check"

    if [ ! -f "package.json" ]; then
        step_fail
        add_error "$(printf '%b' "${RED}未找到 package.json，无法 type-check${NC}")"
    elif ! command -v npm >/dev/null 2>&1; then
        step_fail
        add_error "$(printf '%b' "${RED}未找到 npm，无法 type-check${NC}")"
    else
        FILTERS=""
        if [ "${FULL_TYPECHECK:-0}" != "1" ]; then
            FILTERS=$(build_typecheck_filters "$FILES")
        fi

        # 输出留在日志和屏幕（错误优先：失败时打印；成功时静默不刷屏）
        if [ -n "$FILTERS" ]; then
            [ "${HOOK_VERBOSE:-0}" = "1" ] && printf "\n${DIM}    使用 filter: %s${NC}\n" "$FILTERS"
            # shellcheck disable=SC2086
            npx --no-install turbo run type-check $FILTERS --output-logs=errors-only >"$LOG_FILE" 2>&1
        else
            [ "${HOOK_VERBOSE:-0}" = "1" ] && printf "\n${DIM}    根目录有变更或开启 FULL_TYPECHECK，执行全量 type-check${NC}\n"
            npx --no-install turbo run type-check --output-logs=errors-only >"$LOG_FILE" 2>&1
        fi
        TC_EXIT=$?

        if [ "$TC_EXIT" -ne 0 ]; then
            step_fail
            # 失败时把完整 type-check 输出打印到终端
            echo ""
            printf "${RED}── TypeScript 错误明细 ──${NC}\n"
            if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
                # 仅显示 TS 错误相关的行（带 error TS 或 .ts(line,col): 形式），其余截断
                # 直接 cat 完整内容，但首尾添加分隔，便于辨识
                cat "$LOG_FILE"
            fi
            printf "${RED}──────────────────────${NC}\n\n"
            add_error "$(printf '%b' "${RED}type-check 失败${NC}\n  ${YELLOW}→ 本地复现：npm run type-check${NC}\n  ${YELLOW}→ 完整日志：$LOG_FILE${NC}")"
        else
            step_ok
        fi
    fi
fi

# ========================================
# [4] 项目编译（默认开启，需 RUN_BUILD=1）
# ========================================
if [ "${RUN_BUILD:-1}" = "1" ]; then
    step_begin "项目编译（npm run build）"

    if [ ! -f "package.json" ]; then
        step_fail
        add_error "$(printf '%b' "${RED}未找到 package.json，无法 build${NC}")"
    elif ! command -v npm >/dev/null 2>&1; then
        step_fail
        add_error "$(printf '%b' "${RED}未找到 npm，无法 build${NC}")"
    else
        npm run build >"$LOG_FILE.build" 2>&1
        BUILD_EXIT=$?
        if [ "$BUILD_EXIT" -ne 0 ]; then
            step_fail
            echo ""
            printf "${RED}── Build 错误明细 ──${NC}\n"
            # 显示日志最后 80 行，避免淹没终端
            tail -n 80 "$LOG_FILE.build" 2>/dev/null
            printf "${RED}────────────────────${NC}\n\n"
            add_error "$(printf '%b' "${RED}npm run build 失败${NC}\n  ${YELLOW}→ 本地复现：npm run build${NC}\n  ${YELLOW}→ 完整日志：$LOG_FILE.build${NC}")"
        else
            step_ok
            rm -f "$LOG_FILE.build" 2>/dev/null || true
        fi
    fi
fi

# ========================================
# 总结
# ========================================
TOTAL_ELAPSED=$(elapsed "$HOOK_START")
echo ""
printf "%s\n" "────────────────────────────────────────"
if [ "$ERRORS" -gt 0 ]; then
    printf "${RED}${BOLD}✗ pre-commit 检查失败${NC}  ${DIM}(总耗时 %ss)${NC}\n" "$TOTAL_ELAPSED"
    printf "   ${RED}错误：%d${NC}    ${YELLOW}警告：%d${NC}\n" "$ERRORS" "$WARNINGS"
    echo ""
    # 逐条打印错误详情（用分隔符 ||| 切分）
    printf "%s\n" "$ERROR_DETAILS" | awk -v RS='\\|\\|\\|' 'NF { print "● " $0; print "" }'
    printf "${YELLOW}💡 临时跳过本次检查：${BLUE}git commit --no-verify${NC}\n"
    exit 1
elif [ "$WARNINGS" -gt 0 ]; then
    printf "${YELLOW}${BOLD}⚠ pre-commit 通过（带警告）${NC}  ${DIM}(总耗时 %ss)${NC}\n" "$TOTAL_ELAPSED"
    printf "   ${GREEN}错误：0${NC}    ${YELLOW}警告：%d${NC}\n" "$WARNINGS"
else
    printf "${GREEN}${BOLD}✅ pre-commit 检查全部通过${NC}  ${DIM}(总耗时 %ss)${NC}\n" "$TOTAL_ELAPSED"
fi

exit 0
