#!/bin/sh
# ========================================
# pre-push hook - 推送前检查
# ========================================
# 
# 功能：在推送到 GitLab 前执行最后的检查
# 用途：防止将问题代码推送到远程仓库
# ========================================

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo "${BLUE}🚀 执行推送前检查...${NC}"
echo ""

# 获取当前分支
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ -z "$CURRENT_BRANCH" ]; then
    echo "${YELLOW}⚠  无法确定当前分支，跳过检查${NC}"
    exit 0
fi

echo "📌 当前分支: ${GREEN}$CURRENT_BRANCH${NC}"
echo ""

ERRORS=0
WARNINGS=0

# ========================================
# 1. 检查保护分支
# ========================================
echo "${BLUE}[1/5]${NC} 检查保护分支..."
PROTECTED_BRANCHES="^(dev|main|production|release)$"
if echo "$CURRENT_BRANCH" | grep -qE "$PROTECTED_BRANCHES"; then
    echo "${RED}✗ 错误: 不允许直接推送到保护分支 '$CURRENT_BRANCH'${NC}"
    echo ""
    echo "${YELLOW}建议操作：${NC}"
    echo "   1. 创建新分支: ${BLUE}git checkout -b feature/your-feature${NC}"
    echo "   2. 推送新分支: ${BLUE}git push origin feature/your-feature${NC}"
    echo "   3. 在 GitLab 上创建 Merge Request"
    echo ""
    echo "${YELLOW}💡 提示:${NC} 如确需推送，可使用: ${BLUE}git push --no-verify${NC}"
    exit 1
else
    echo "${GREEN}✓ 通过${NC}"
fi

# ========================================
# 2. 检查分支命名规范
# ========================================
echo "${BLUE}[2/5]${NC} 检查分支命名规范..."
VALID_BRANCH_REGEX="^(feature|bugfix|hotfix|release|develop|dev)/.+"
if ! echo "$CURRENT_BRANCH" | grep -qE "$VALID_BRANCH_REGEX"; then
    echo "${YELLOW}⚠  警告: 分支名称不符合命名规范${NC}"
    echo "   ${YELLOW}建议使用以下格式：${NC}"
    echo "   - ${GREEN}feature/${NC}功能名称"
    echo "   - ${GREEN}bugfix/${NC}问题描述"
    echo "   - ${GREEN}hotfix/${NC}紧急修复"
    echo "   - ${GREEN}release/${NC}版本号"
    WARNINGS=$((WARNINGS + 1))
else
    echo "${GREEN}✓ 通过${NC}"
fi

# ========================================
# 3. 检查未提交的修改
# ========================================
echo "${BLUE}[3/5]${NC} 检查未提交的修改..."
if ! git diff-index --quiet HEAD --; then
    echo "${YELLOW}⚠  警告: 存在未提交的修改${NC}"
    echo "   ${YELLOW}建议先提交所有修改再推送${NC}"
    echo ""
    git status --short | head -10
    WARNINGS=$((WARNINGS + 1))
else
    echo "${GREEN}✓ 通过${NC}"
fi

# ========================================
# 4. 检查远程分支更新
# ========================================
echo "${BLUE}[4/5]${NC} 检查远程更新..."
REMOTE="origin"

# 静默获取远程更新
git fetch "$REMOTE" "$CURRENT_BRANCH" 2>/dev/null || {
    echo "${YELLOW}⚠  警告: 无法获取远程分支信息${NC}"
    echo "${GREEN}✓ 跳过${NC}"
}

LOCAL=$(git rev-parse @ 2>/dev/null)
REMOTE_REF=$(git rev-parse @{u} 2>/dev/null || echo "")
BASE=$(git merge-base @ @{u} 2>/dev/null || echo "")

if [ -z "$REMOTE_REF" ]; then
    echo "${BLUE}ℹ  新分支，远程不存在${NC}"
elif [ "$LOCAL" = "$REMOTE_REF" ]; then
    echo "${GREEN}✓ 本地和远程同步${NC}"
elif [ "$LOCAL" = "$BASE" ]; then
    echo "${YELLOW}⚠  警告: 远程分支有更新，建议先拉取${NC}"
    echo "   执行: ${BLUE}git pull --rebase${NC}"
    WARNINGS=$((WARNINGS + 1))
elif [ "$REMOTE_REF" = "$BASE" ]; then
    echo "${GREEN}✓ 本地领先于远程${NC}"
else
    echo "${YELLOW}⚠  警告: 分支已分叉，建议先同步远程修改${NC}"
    echo "   执行: ${BLUE}git pull --rebase${NC}"
    WARNINGS=$((WARNINGS + 1))
fi

# ========================================
# 5. 验证所有提交消息格式
# ========================================
echo "${BLUE}[5/5]${NC} 验证所有提交消息格式..."

# 定义提交类型（与 commit-msg hook 保持一致）
COMMIT_TYPES="feat|fix|perf|build|chore|docs|style|refactor|test|revert|ci|localize|deps"

# 获取待推送的提交
if [ -n "$REMOTE_REF" ]; then
    COMMITS=$(git log --oneline --no-merges @{u}..HEAD 2>/dev/null || echo "")
else
    COMMITS=$(git log --oneline --no-merges HEAD~5..HEAD 2>/dev/null || echo "")
fi

if [ -z "$COMMITS" ]; then
    echo "${BLUE}ℹ  没有新提交需要检查${NC}"
else
    echo "📝 检查以下提交："
    echo "$COMMITS" | sed 's/^/   /'
    echo ""
    
    FORMAT_ERRORS=0
    echo "$COMMITS" | while IFS= read -r line; do
        if [ -n "$line" ]; then
            # 提取提交消息（移除提交哈希）
            commit_msg=$(echo "$line" | sed 's/^[a-f0-9]* //')
            
            # 验证格式
            if ! echo "$commit_msg" | grep -qE "^($COMMIT_TYPES)(\([^)]+\))?: .+"; then
                echo "${RED}✗ 格式错误: $commit_msg${NC}"
                FORMAT_ERRORS=$((FORMAT_ERRORS + 1))
            fi
        fi
    done
    
    if [ $FORMAT_ERRORS -eq 0 ]; then
        echo "${GREEN}✓ 所有提交消息格式正确${NC}"
    else
        echo "${RED}✗ 发现 $FORMAT_ERRORS 个提交消息格式错误${NC}"
        echo ""
        echo "${YELLOW}请使用 'git commit --amend' 或 'git rebase -i' 修改提交消息${NC}"
        ERRORS=$((ERRORS + 1))
    fi
fi

# ========================================
# 6. 可选：运行测试（已禁用）
# ========================================
# 取消下面的注释以启用自动测试
# echo "${BLUE}[额外]${NC} 运行测试..."
# if [ -f "package.json" ]; then
#     if grep -q '"test"' package.json; then
#         echo "检测到测试脚本，运行测试..."
#         npm test || pnpm test
#         if [ $? -ne 0 ]; then
#             echo "${RED}✗ 测试失败，取消推送${NC}"
#             exit 1
#         fi
#     fi
# fi

# ========================================
# 检查结果
# ========================================
echo ""
echo "================================"
if [ $ERRORS -gt 0 ]; then
    echo "${RED}✗ 推送前检查失败！${NC}"
    echo "   ${RED}错误: $ERRORS${NC}"
    echo "   ${YELLOW}警告: $WARNINGS${NC}"
    echo ""
    echo "${YELLOW}💡 提示:${NC}"
    echo "   - 请修复以上错误后重新推送"
    echo "   - 如确需推送，可使用: ${BLUE}git push --no-verify${NC}"
    exit 1
elif [ $WARNINGS -gt 0 ]; then
    echo "${YELLOW}⚠  推送前检查通过（有警告）${NC}"
    echo "   ${GREEN}错误: 0${NC}"
    echo "   ${YELLOW}警告: $WARNINGS${NC}"
    echo ""
    echo "${YELLOW}💡 提示: 建议处理警告信息${NC}"
else
    echo "${GREEN}✅ 推送前检查全部通过！${NC}"
fi

echo ""
echo "${GREEN}🚀 准备推送到 GitLab...${NC}"
exit 0

