# 版本控制
.git/**
.gitignore
.gitattributes

# 编辑器配置
.vscode/**
.vscode-test/**
*.code-workspace

# TypeScript
**/*.ts
**/*.map
tsconfig.*.json

# 文档和说明
README.md
CHANGELOG.md
*.md
