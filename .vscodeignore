# 日志和临时文件
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# 测试相关
**/*.test.*
**/*.spec.*
coverage/**
.nyc_output/**

# 其他配置文件
.eslintrc*
.prettierrc*
.editorconfig
.npmrc
.nvmrc

# CI/CD
.github/**
.gitlab-ci.yml
azure-pipelines.yml

# monorepo 其他应用（不应打包）
apps/docs/**
apps/webview/**
# extension 整个目录（源代码已打包到 dist/extension，不需要包含源目录）
extension/**
# 但保留所有 dist 构建输出（extension 和 webview 的构建产物）
!dist/**


# monorepo 其他 packages（不应打包）
packages/**

# 临时和输出文件
out/**
*.vsix
