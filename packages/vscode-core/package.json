{
  "name": "@orientais/vscode-core",
  "version": "0.1.0",
  "description": "Core utilities, dependency injection, logging and VS Code integration helpers",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./commands": {
      "import": "./src/commands/commandBase.ts",
      "types": "./src/commands/commandBase.ts"
    },
    "./instantiation": {
      "import": "./src/instantiation/instantiation.ts",
      "types": "./src/instantiation/instantiation.ts"
    },
    "./quickpick": {
      "import": "./src/quickpick/directive.ts",
      "types": "./src/quickpick/directive.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ --fix",
    "format": "prettier --write src/"
  },
  "peerDependencies": {
    "vscode": "^1.101.0"
  }
}
