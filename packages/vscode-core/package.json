{
  "name": "@orientais/vscode-core",
  "version": "0.1.0",
  "description": "Core utilities, dependency injection, logging and VS Code integration helpers",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": "./*"
  },
  "scripts": {
    "dev": "vite build --mode development",
    "watch": "vite build --mode development --watch",
    "build": "vite build --mode production",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ --fix",
    "format": "prettier --write src/",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "vite-plugin-dts": "^4.3.0"
  },
  "peerDependencies": {
    "@types/vscode": "^1.101.0"
  },
  "peerDependenciesMeta": {
    "@types/vscode": {
      "optional": true
    }
  }
}
