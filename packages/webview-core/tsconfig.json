{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "esnext.disposable"],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "paths": {
      "@/*": ["./src/*"],
      "@packages/*": ["../../packages/*"],
      "@shared/*": ["../../shared/*"],
      "@orientais/vscode-core": ["../vscode-core/src/index.ts"],
      "@orientais/vscode-core/*": ["../vscode-core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.tsx", "src/**/*.d.ts", "../../types/global.d.ts", "*.d.ts"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/*"]
}
