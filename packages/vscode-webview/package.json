{
  "name": "@orientais/vscode-webview",
  "version": "0.1.0",
  "description": "Webview host, provider and IPC utilities for VS Code extensions",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./ipc": {
      "import": "./src/ipc/handlerRegistry.ts",
      "types": "./src/ipc/handlerRegistry.ts"
    },
    "./types": {
      "import": "./src/types.ts",
      "types": "./src/types.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ --fix",
    "format": "prettier --write src/"
  },
  "peerDependencies": {
    "vscode": "^1.101.0"
  }
}
