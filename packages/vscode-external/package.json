{
  "name": "@orientais/vscode-external",
  "version": "0.1.0",
  "description": "External process and SSH channel utilities for VS Code extensions",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./channels": {
      "import": "./dist/channels/shellChannel.js",
      "types": "./dist/channels/shellChannel.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/shellBasedProvider.js",
      "types": "./dist/providers/shellBasedProvider.d.ts"
    },
    "./types": {
      "import": "./dist/types/protocol.js",
      "types": "./dist/types/protocol.d.ts"
    }
  },
  "scripts": {
    "dev": "vite build --mode development",
    "watch": "vite build --mode development --watch",
    "build": "vite build --mode production",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ --fix",
    "format": "prettier --write src/",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "vite-plugin-dts": "^4.3.0"
  },
  "peerDependencies": {
    "@types/vscode": "^1.101.0"
  },
  "peerDependenciesMeta": {
    "@types/vscode": {
      "optional": true
    }
  }
}
