{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@packages/*": ["../*"],
      "@shared/*": ["../../shared/*"],
      "@orientais/vscode-core": ["../vscode-core/src/index.ts"],
      "@orientais/vscode-core/*": ["../vscode-core/src/*"],
      "@orientais/vscode-external": ["./src/index.ts"],
      "@orientais/vscode-external/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../types/global.d.ts"]
}
