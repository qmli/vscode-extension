{
  "name": "orientais-extension",
  "displayName": "Orientais VSCode Extension",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "npm run watch:webpack",
    "build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
    "build:dev": "cross-env NODE_ENV=development webpack --config webpack.config.js",
    "watch": "npm-run-all -p watch:webpack watch:tsc",
    "watch:webpack": "cross-env NODE_ENV=development webpack --config webpack.config.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run lint",
    "check-types": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "clean": "rimraf dist out"
  },
  "devDependencies": {
    "@types/log4js": "^0.0.33",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.101.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1",
    "copy-webpack-plugin": "14.0.0",
    "cross-env": "^7.0.3",
    "npm-run-all": "^4.1.5",
    "ts-loader": "^9.5.1",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "@journeyapps/sqlcipher": "^5.3.1",
    "@types/ssh2": "1.15.5",
    "chardet": "2.1.1",
    "fast-glob": "3.3.3",
    "iconv-lite": "0.7.1",
    "jsonpath-plus": "10.3.0",
    "log4js": "^6.9.1",
    "ssh2": "1.17.0"
  }
}
